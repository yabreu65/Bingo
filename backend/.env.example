# ========== BACKEND CONFIGURATION ==========

# Server
PORT=5001
NODE_ENV=development

# Network access: local, lan, or public. Keep local until the event is explicitly prepared.
BINGO_ACCESS_MODE=local
TRUST_PROXY_HOPS=0

# MongoDB
MONGODB_URI=mongodb://localhost:27017/bingo-navidad

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this

# Spotify API
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret  
SPOTIFY_REDIRECT_URI=http://localhost:5001/api/spotify/callback

# YouTube API
YOUTUBE_API_KEY=your-youtube-api-key

# Claude API
ANTHROPIC_API_KEY=your-anthropic-api-key

# CORS
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=
LAN_ORIGINS=http://192.168.1.39:5173
