# Copy this file to .env outside Git and fill every required value.
# Never commit the copied file or paste its values into logs.

# Generated after the Quick Tunnel returns its HTTPS hostname.
BINGO_ACCESS_MODE=public
FRONTEND_URL=https://REPLACE-AFTER-QUICK-TUNNEL.example
ALLOWED_ORIGINS=https://REPLACE-AFTER-QUICK-TUNNEL.example
TRUST_PROXY_HOPS=1
VITE_BACKEND_URL=same-origin
VITE_SHAREABLE_ORIGIN=https://REPLACE-AFTER-QUICK-TUNNEL.example

# Bind the local Nginx port to loopback only.
FRONTEND_PORT=8080

# Generate fresh values for this rehearsal only.
MONGO_ROOT_USERNAME=bingo_m59
MONGO_ROOT_PASSWORD=REPLACE_WITH_OPENSSL_RANDOM_HEX
JWT_SECRET=REPLACE_WITH_OPENSSL_RANDOM_HEX
