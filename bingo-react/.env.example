# Backend URL: use same-origin behind the production reverse proxy.
VITE_BACKEND_URL=http://localhost:5001

# Network IP - Tu IP en la red local para acceder desde otros dispositivos
# Cámbialo a tu IP actual (ejecuta: ifconfig | grep "inet " | grep -v 127.0.0.1)
VITE_NETWORK_IP=

# Optional explicit public origin used in QR codes and temporary TV links.
VITE_SHAREABLE_ORIGIN=

# Loopback-only media service used by a REMOTE_PRESENTIAL TV laptop.
# The service must bind to 127.0.0.1 and use the generated relative-path manifest.
VITE_LOCAL_TV_MEDIA_ORIGIN=http://127.0.0.1:8787

# YouTube API (OPCIONAL - Solo para búsqueda avanzada)
# VITE_YOUTUBE_API_KEY=TU_API_KEY_AQUI
